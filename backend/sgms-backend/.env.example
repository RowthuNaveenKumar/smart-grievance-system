# ==============================================================================
# SGMS Spring Boot Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to .env_sen and provide your actual local credentials.
# NEVER commit .env_sen or real credentials to GitHub.
# ==============================================================================

# Server Configuration
PORT=8080

# Database Configuration (MySQL)
DATASOURCE_URL=jdbc:mysql://localhost:3306/sgdb
DATASOURCE_USER=your_db_username
DATASOURCE_PASSWORD=your_db_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# ML Microservice Connection
ML_API_URL=http://127.0.0.1:8000/predict
ML_CONFIDENCE_THRESHOLD=0.60

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
