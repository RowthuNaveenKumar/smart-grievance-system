# ==============================================================================
# SGMS Frontend (Vite + React) - Environment Configuration Example
# ==============================================================================
# Copy this file to .env_sen or .env.local and configure your API URL.
# NOTE: Only public variables prefixed with VITE_ are exposed to the browser.
# NEVER put private server keys, database passwords, or JWT secrets here!
# ==============================================================================

# Backend Spring Boot API Base URL
VITE_API_BASE_URL=http://localhost:8080
